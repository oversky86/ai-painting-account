# Public URL of this account-web deployment (no trailing slash)
ACCOUNT_WEB_URL=https://your-account-web.vercel.app

# Shopify storefront domain (myshopify.com or custom primary domain used for discovery)
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com

# Customer Account API OAuth client (from app customer_authentication / Partner Dashboard)
SHOPIFY_CUSTOMER_ACCOUNT_CLIENT_ID=

# Encrypt HostOnly session cookie (min 32 chars)
SESSION_SECRET=replace-with-long-random-string

# Shared HMAC secret with ecommerce-pet-app write API
ACCOUNT_HMAC_SECRET=replace-with-shared-hmac-secret

# App backend write API base (no trailing slash)
APP_WRITE_API_URL=https://pet-paiting-app.vercel.app

# Storefront origin for Create Artwork / Cart / logout handoff
STOREFRONT_URL=https://your-store.myshopify.com

# Native Shopify Customer Account profile URL (Edit / Change password / addresses)
NATIVE_ACCOUNT_PROFILE_URL=https://shopify.com/YOUR_SHOP_ID/account/profile
NATIVE_ACCOUNT_URL=https://shopify.com/YOUR_SHOP_ID/account
