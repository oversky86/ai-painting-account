# Public URL of this account-web deployment (no trailing slash)
ACCOUNT_WEB_URL=https://ai-painting-account.vercel.app

# Multi-shop config (JSON array). Prefer this over single-shop vars below.
# Theme links pass ?shop=<myshopify.com domain> so the correct row is used.
ACCOUNT_SHOPS=[{"storeDomain":"w4yzmt-vv.myshopify.com","clientId":"95a4a9972a0fc9d0d899293e2b62644f","storefrontUrl":"https://w4yzmt-vv.myshopify.com","nativeAccountUrl":"https://shopify.com/YOUR_PROD_SHOP_ID/account","nativeAccountProfileUrl":"https://shopify.com/YOUR_PROD_SHOP_ID/account/profile"},{"storeDomain":"e-commerce-dev-v6yidmlw.myshopify.com","clientId":"8f74713e6783c3adeb81b302e8e95866","storefrontUrl":"https://e-commerce-dev-v6yidmlw.myshopify.com","nativeAccountUrl":"https://shopify.com/96406864056/account","nativeAccountProfileUrl":"https://shopify.com/96406864056/account/profile"}]

# Legacy single-shop fallback (used when ACCOUNT_SHOPS is unset)
# SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
# SHOPIFY_CUSTOMER_ACCOUNT_CLIENT_ID=
# STOREFRONT_URL=https://your-store.myshopify.com
# NATIVE_ACCOUNT_PROFILE_URL=https://shopify.com/YOUR_SHOP_ID/account/profile
# NATIVE_ACCOUNT_URL=https://shopify.com/YOUR_SHOP_ID/account

# Encrypt HostOnly session cookie (min 32 chars)
SESSION_SECRET=replace-with-long-random-string

# Shared HMAC secret with ecommerce-pet-app write API
ACCOUNT_HMAC_SECRET=replace-with-shared-hmac-secret

# App backend write API base (no trailing slash)
APP_WRITE_API_URL=https://pet-paiting-app.vercel.app
